{
  "Execution3": {
    "$defs": {
      "Checkpoint3": {
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Artifact",
            "type": "string"
          },
          "complete": {
            "const": true,
            "default": true,
            "title": "Complete",
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "sample",
              "findings",
              "window_evaluation",
              "report"
            ],
            "title": "Kind",
            "type": "string"
          },
          "sequence": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Sequence",
            "type": "string",
            "x-integer-minimum": "1"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "version": {
            "const": "diagnostic-checkpoint-3",
            "default": "diagnostic-checkpoint-3",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "sequence",
          "kind",
          "artifact",
          "sha256"
        ],
        "title": "Checkpoint3",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "cancel_requested": {
        "default": false,
        "title": "Cancel Requested",
        "type": "boolean"
      },
      "checkpoints": {
        "default": [],
        "items": {
          "$ref": "#/$defs/Checkpoint3"
        },
        "title": "Checkpoints",
        "type": "array"
      },
      "exit_code": {
        "anyOf": [
          {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Exit Code"
      },
      "forced_termination": {
        "default": false,
        "title": "Forced Termination",
        "type": "boolean"
      },
      "phase": {
        "title": "Phase",
        "type": "string"
      },
      "profile_digest": {
        "anyOf": [
          {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Profile Digest"
      },
      "reason_code": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Reason Code"
      },
      "state": {
        "enum": [
          "queued",
          "running",
          "completed",
          "stopped",
          "failed",
          "interrupted"
        ],
        "title": "State",
        "type": "string"
      },
      "task_id": {
        "title": "Task Id",
        "type": "string"
      },
      "telemetry": {
        "additionalProperties": true,
        "title": "Telemetry",
        "type": "object"
      },
      "version": {
        "const": "diagnostics-execution-3",
        "default": "diagnostics-execution-3",
        "title": "Version",
        "type": "string"
      }
    },
    "required": [
      "task_id",
      "state",
      "phase"
    ],
    "title": "Execution3",
    "type": "object"
  },
  "SampleReport3": {
    "$defs": {
      "AnalysisScope": {
        "additionalProperties": false,
        "properties": {
          "appid": {
            "minLength": 1,
            "title": "Appid",
            "type": "string"
          },
          "baseline_origin": {
            "enum": [
              "original_run_window",
              "selected_window_recomputed"
            ],
            "title": "Baseline Origin",
            "type": "string"
          },
          "request_count": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Request Count",
            "type": "string",
            "x-integer-minimum": "0"
          },
          "request_keys_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Request Keys Digest",
            "type": "string"
          },
          "source": {
            "$ref": "#/$defs/SourceIdentity"
          },
          "window": {
            "anyOf": [
              {
                "$ref": "#/$defs/TimeWindow"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source",
          "appid",
          "window",
          "request_count",
          "request_keys_digest",
          "baseline_origin"
        ],
        "title": "AnalysisScope",
        "type": "object"
      },
      "CauseGroup3": {
        "additionalProperties": false,
        "properties": {
          "comparison": {
            "anyOf": [
              {
                "$ref": "#/$defs/RequestComparison"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "context_status": {
            "default": "pair_evidence_only",
            "title": "Context Status",
            "type": "string"
          },
          "group_id": {
            "title": "Group Id",
            "type": "string"
          },
          "input_changed": {
            "title": "Input Changed",
            "type": "boolean"
          },
          "lcp_tokens": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Lcp Tokens",
            "type": "string"
          },
          "members": {
            "items": {
              "$ref": "#/$defs/RequestKey"
            },
            "title": "Members",
            "type": "array"
          },
          "observed_pairs": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Observed Pairs",
            "type": "string"
          },
          "pointers": {
            "items": {
              "type": "string"
            },
            "title": "Pointers",
            "type": "array"
          },
          "rule_id": {
            "title": "Rule Id",
            "type": "string"
          }
        },
        "required": [
          "group_id",
          "rule_id",
          "pointers",
          "members",
          "observed_pairs",
          "input_changed",
          "lcp_tokens"
        ],
        "title": "CauseGroup3",
        "type": "object"
      },
      "ClockDiscovery3": {
        "additionalProperties": false,
        "properties": {
          "candidate_limit": {
            "default": "16",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Candidate Limit",
            "type": "string"
          },
          "cause_groups": {
            "default": [],
            "items": {
              "$ref": "#/$defs/CauseGroup3"
            },
            "title": "Cause Groups",
            "type": "array"
          },
          "channel_visits": {
            "additionalProperties": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "type": "string"
            },
            "default": {},
            "title": "Channel Visits",
            "type": "object"
          },
          "checked_requests": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Checked Requests",
            "type": "string"
          },
          "comparisons": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Comparisons",
            "type": "string"
          },
          "complete": {
            "default": true,
            "title": "Complete",
            "type": "boolean"
          },
          "evidence_requests": {
            "default": [],
            "items": {
              "$ref": "#/$defs/EvidenceRequest3"
            },
            "title": "Evidence Requests",
            "type": "array"
          },
          "findings": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ClockFinding3"
                },
                {
                  "$ref": "#/$defs/PrefixFinding3"
                }
              ]
            },
            "title": "Findings",
            "type": "array"
          },
          "reason_codes": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "scope_id": {
            "title": "Scope Id",
            "type": "string"
          },
          "unsupported_fields": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Unsupported Fields",
            "type": "string"
          }
        },
        "required": [
          "scope_id",
          "findings",
          "checked_requests",
          "comparisons",
          "unsupported_fields"
        ],
        "title": "ClockDiscovery3",
        "type": "object"
      },
      "ClockFinding3": {
        "additionalProperties": false,
        "properties": {
          "advice": {
            "default": "固定session_clock会改变模型的时间感知；仅在样本副本评估，需业务确认，不承诺业务无损。",
            "title": "Advice",
            "type": "string"
          },
          "after_fragments": {
            "items": {
              "type": "string"
            },
            "title": "After Fragments",
            "type": "array"
          },
          "before_fragments": {
            "items": {
              "type": "string"
            },
            "title": "Before Fragments",
            "type": "array"
          },
          "comparison": {
            "$ref": "#/$defs/RequestComparison"
          },
          "evidence_status": {
            "const": "clock_change_and_input_difference",
            "default": "clock_change_and_input_difference",
            "title": "Evidence Status",
            "type": "string"
          },
          "finding_id": {
            "title": "Finding Id",
            "type": "string"
          },
          "left_date_ranges": {
            "items": {
              "items": {
                "$ref": "#/$defs/TextRange"
              },
              "type": "array"
            },
            "title": "Left Date Ranges",
            "type": "array"
          },
          "left_locations": {
            "items": {
              "$ref": "#/$defs/Location"
            },
            "title": "Left Locations",
            "type": "array"
          },
          "recipe": {
            "$ref": "#/$defs/ClockRecipe3"
          },
          "right_date_ranges": {
            "items": {
              "items": {
                "$ref": "#/$defs/TextRange"
              },
              "type": "array"
            },
            "title": "Right Date Ranges",
            "type": "array"
          },
          "right_locations": {
            "items": {
              "$ref": "#/$defs/Location"
            },
            "title": "Right Locations",
            "type": "array"
          },
          "rule_id": {
            "const": "L1",
            "default": "L1",
            "title": "Rule Id",
            "type": "string"
          },
          "rule_version": {
            "const": "clock-3.1",
            "default": "clock-3.1",
            "title": "Rule Version",
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "comparison",
          "left_locations",
          "right_locations",
          "left_date_ranges",
          "right_date_ranges",
          "recipe",
          "before_fragments",
          "after_fragments"
        ],
        "title": "ClockFinding3",
        "type": "object"
      },
      "ClockRecipe3": {
        "additionalProperties": false,
        "properties": {
          "block_indices": {
            "items": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "type": "string"
            },
            "minItems": 1,
            "title": "Block Indices",
            "type": "array"
          },
          "business_effect": {
            "const": "changes_time_awareness",
            "default": "changes_time_awareness",
            "title": "Business Effect",
            "type": "string"
          },
          "constant": {
            "const": "NORMALIZED",
            "default": "NORMALIZED",
            "title": "Constant",
            "type": "string"
          },
          "discovery": {
            "const": "automatic_l1",
            "default": "automatic_l1",
            "title": "Discovery",
            "type": "string"
          },
          "field_shape": {
            "items": {
              "type": "string"
            },
            "title": "Field Shape",
            "type": "array"
          },
          "logical_field": {
            "title": "Logical Field",
            "type": "string"
          },
          "version": {
            "const": "session-clock-normalize-3.1",
            "default": "session-clock-normalize-3.1",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "logical_field",
          "field_shape",
          "block_indices"
        ],
        "title": "ClockRecipe3",
        "type": "object"
      },
      "EmbeddedLocation": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "const": "json",
            "default": "json",
            "title": "Format",
            "type": "string"
          },
          "parser_version": {
            "minLength": 1,
            "title": "Parser Version",
            "type": "string"
          },
          "pointer": {
            "title": "Pointer",
            "type": "string"
          }
        },
        "required": [
          "parser_version",
          "pointer"
        ],
        "title": "EmbeddedLocation",
        "type": "object"
      },
      "EvidenceRequest3": {
        "additionalProperties": false,
        "properties": {
          "raw_body": {
            "title": "Raw Body",
            "type": "string"
          },
          "raw_sha256": {
            "title": "Raw Sha256",
            "type": "string"
          },
          "request_key": {
            "$ref": "#/$defs/RequestKey"
          }
        },
        "required": [
          "request_key",
          "raw_sha256",
          "raw_body"
        ],
        "title": "EvidenceRequest3",
        "type": "object"
      },
      "ExcludedRecord": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "$ref": "#/$defs/RequestKey"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "key",
          "reason"
        ],
        "title": "ExcludedRecord",
        "type": "object"
      },
      "Location": {
        "additionalProperties": false,
        "properties": {
          "embedded": {
            "anyOf": [
              {
                "$ref": "#/$defs/EmbeddedLocation"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "raw_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Raw Sha256",
            "type": "string"
          },
          "request_key": {
            "$ref": "#/$defs/RequestKey"
          },
          "source_pointer": {
            "title": "Source Pointer",
            "type": "string"
          },
          "text_range": {
            "anyOf": [
              {
                "$ref": "#/$defs/TextRange"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "request_key",
          "raw_sha256",
          "source_pointer"
        ],
        "title": "Location",
        "type": "object"
      },
      "PrefixFinding3": {
        "additionalProperties": false,
        "properties": {
          "advice": {
            "title": "Advice",
            "type": "string"
          },
          "after_fragments": {
            "items": {
              "type": "string"
            },
            "title": "After Fragments",
            "type": "array"
          },
          "before_fragments": {
            "items": {
              "type": "string"
            },
            "title": "Before Fragments",
            "type": "array"
          },
          "comparison": {
            "$ref": "#/$defs/RequestComparison"
          },
          "evidence_status": {
            "default": "source_change_and_input_difference",
            "enum": [
              "source_change_and_input_difference",
              "source_change_input_identical"
            ],
            "title": "Evidence Status",
            "type": "string"
          },
          "finding_id": {
            "title": "Finding Id",
            "type": "string"
          },
          "left_locations": {
            "items": {
              "$ref": "#/$defs/Location"
            },
            "title": "Left Locations",
            "type": "array"
          },
          "recipe": {
            "$ref": "#/$defs/PrefixRecipe3"
          },
          "right_locations": {
            "items": {
              "$ref": "#/$defs/Location"
            },
            "title": "Right Locations",
            "type": "array"
          },
          "rule_id": {
            "enum": [
              "L1",
              "L2",
              "L3"
            ],
            "title": "Rule Id",
            "type": "string"
          },
          "rule_version": {
            "const": "prefix-3.2",
            "default": "prefix-3.2",
            "title": "Rule Version",
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "rule_id",
          "comparison",
          "left_locations",
          "right_locations",
          "recipe",
          "advice",
          "before_fragments",
          "after_fragments"
        ],
        "title": "PrefixFinding3",
        "type": "object"
      },
      "PrefixRecipe3": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "dynamic_remove",
              "sort_tools"
            ],
            "title": "Kind",
            "type": "string"
          },
          "pattern": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pattern"
          },
          "set_digest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Set Digest"
          },
          "shape": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Shape",
            "type": "array"
          },
          "slot_index": {
            "anyOf": [
              {
                "pattern": "^(0|-?[1-9][0-9]*)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Slot Index"
          },
          "slot_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Slot Key"
          },
          "version": {
            "const": "prefix-transform-3.2",
            "default": "prefix-transform-3.2",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "PrefixRecipe3",
        "type": "object"
      },
      "Rational3": {
        "additionalProperties": false,
        "properties": {
          "denominator": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Denominator",
            "type": "string",
            "x-integer-exclusiveMinimum": "0"
          },
          "numerator": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Numerator",
            "type": "string"
          }
        },
        "required": [
          "numerator",
          "denominator"
        ],
        "title": "Rational3",
        "type": "object"
      },
      "Recommendation3": {
        "additionalProperties": false,
        "properties": {
          "finding": {
            "anyOf": [
              {
                "$ref": "#/$defs/ClockFinding3"
              },
              {
                "$ref": "#/$defs/PrefixFinding3"
              }
            ],
            "title": "Finding"
          },
          "transformation_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Transformation Digest",
            "type": "string"
          },
          "windows": {
            "items": {
              "$ref": "#/$defs/WindowEvaluation3"
            },
            "title": "Windows",
            "type": "array"
          }
        },
        "required": [
          "finding",
          "transformation_digest",
          "windows"
        ],
        "title": "Recommendation3",
        "type": "object"
      },
      "RequestComparison": {
        "additionalProperties": false,
        "properties": {
          "association_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Association Ref"
          },
          "difference_pointers": {
            "items": {
              "type": "string"
            },
            "title": "Difference Pointers",
            "type": "array"
          },
          "lcp_tokens": {
            "anyOf": [
              {
                "pattern": "^(0|-?[1-9][0-9]*)$",
                "type": "string",
                "x-integer-minimum": "0"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Lcp Tokens"
          },
          "left": {
            "$ref": "#/$defs/RequestKey"
          },
          "left_raw_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Left Raw Sha256",
            "type": "string"
          },
          "right": {
            "$ref": "#/$defs/RequestKey"
          },
          "right_raw_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Right Raw Sha256",
            "type": "string"
          }
        },
        "required": [
          "left",
          "right",
          "left_raw_sha256",
          "right_raw_sha256",
          "difference_pointers"
        ],
        "title": "RequestComparison",
        "type": "object"
      },
      "RequestKey": {
        "additionalProperties": false,
        "properties": {
          "base_run_id": {
            "minLength": 1,
            "title": "Base Run Id",
            "type": "string"
          },
          "source_record_index": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Source Record Index",
            "type": "string",
            "x-integer-minimum": "0"
          }
        },
        "required": [
          "base_run_id",
          "source_record_index"
        ],
        "title": "RequestKey",
        "type": "object"
      },
      "SampleLimits": {
        "additionalProperties": false,
        "description": "Internal positive limits; deployment profile selection belongs to runtime v3.",
        "properties": {
          "max_exclusion_examples": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Max Exclusion Examples",
            "type": "string",
            "x-integer-maximum": "1000",
            "x-integer-minimum": "0"
          },
          "max_metadata_bytes": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Max Metadata Bytes",
            "type": "string",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_prompt_tokens": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Max Prompt Tokens",
            "type": "string",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_raw_bytes": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Max Raw Bytes",
            "type": "string",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_record_bytes": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Max Record Bytes",
            "type": "string",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_record_tokens": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "title": "Max Record Tokens",
            "type": "string",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_requests": {
            "pattern": "^(0|-?[1-9][0-9]*)$",
