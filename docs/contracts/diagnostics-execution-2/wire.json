{
  "submission": {
    "$defs": {
      "BudgetSpec": {
        "additionalProperties": false,
        "properties": {
          "max_request_bytes": {
            "title": "Max Request Bytes",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_units": {
            "title": "Max Units",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_comparison_bytes": {
            "title": "Max Comparison Bytes",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_depth": {
            "title": "Max Depth",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_candidates": {
            "title": "Max Candidates",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-exclusiveMinimum": "0"
          },
          "max_encoding_calls": {
            "title": "Max Encoding Calls",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-exclusiveMinimum": "0"
          }
        },
        "required": [
          "max_request_bytes",
          "max_units",
          "max_comparison_bytes",
          "max_depth",
          "max_candidates",
          "max_encoding_calls"
        ],
        "title": "BudgetSpec",
        "type": "object"
      },
      "PluginSelection": {
        "additionalProperties": false,
        "properties": {
          "rule_ids": {
            "items": {
              "type": "string"
            },
            "title": "Rule Ids",
            "type": "array"
          },
          "policies_json": {
            "default": "[]",
            "title": "Policies Json",
            "type": "string"
          },
          "budget": {
            "$ref": "#/$defs/BudgetSpec"
          }
        },
        "required": [
          "rule_ids",
          "budget"
        ],
        "title": "PluginSelection",
        "type": "object"
      },
      "RequestV2": {
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "#/$defs/SourceSelection"
          },
          "selection": {
            "$ref": "#/$defs/SelectionV2"
          },
          "reason_note": {
            "default": "",
            "title": "Reason Note",
            "type": "string"
          },
          "submission_key": {
            "minLength": 1,
            "title": "Submission Key",
            "type": "string"
          }
        },
        "required": [
          "source",
          "selection",
          "submission_key"
        ],
        "title": "RequestV2",
        "type": "object"
      },
      "RuntimeV2": {
        "additionalProperties": false,
        "properties": {
          "version": {
            "const": "diagnostics-runtime-2",
            "default": "diagnostics-runtime-2",
            "title": "Version",
            "type": "string"
          },
          "token_selection": {
            "$ref": "#/$defs/PluginSelection"
          },
          "candidate_limit": {
            "title": "Candidate Limit",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "1",
            "x-integer-maximum": "128"
          },
          "pilot_limit": {
            "title": "Pilot Limit",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "2"
          },
          "max_source_requests": {
            "title": "Max Source Requests",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "1"
          },
          "max_source_bytes": {
            "title": "Max Source Bytes",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "1"
          },
          "max_findings": {
            "title": "Max Findings",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "5"
          },
          "max_experiments": {
            "title": "Max Experiments",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "1"
          },
          "max_combinations": {
            "title": "Max Combinations",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "0"
          },
          "max_encoding_calls": {
            "title": "Max Encoding Calls",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "1"
          },
          "max_plan_bytes": {
            "default": "16777216",
            "title": "Max Plan Bytes",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "1"
          },
          "max_retained_bytes": {
            "default": "4194304",
            "title": "Max Retained Bytes",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "5"
          },
          "max_comparisons": {
            "default": "100000",
            "title": "Max Comparisons",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "1"
          },
          "max_fragment_bytes": {
            "default": "8388608",
            "title": "Max Fragment Bytes",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "1"
          },
          "max_total_fragment_bytes": {
            "default": "67108864",
            "title": "Max Total Fragment Bytes",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$",
            "x-integer-minimum": "1"
          }
        },
        "required": [
          "token_selection",
          "candidate_limit",
          "pilot_limit",
          "max_source_requests",
          "max_source_bytes",
          "max_findings",
          "max_experiments",
          "max_combinations",
          "max_encoding_calls"
        ],
        "title": "RuntimeV2",
        "type": "object"
      },
      "SelectionV2": {
        "additionalProperties": false,
        "properties": {
          "reason_codes": {
            "items": {
              "enum": [
                "low_hit",
                "request_length",
                "qps"
              ],
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "enable_low_hit": {
            "title": "Enable Low Hit",
            "type": "boolean"
          },
          "enable_token_content": {
            "title": "Enable Token Content",
            "type": "boolean"
          }
        },
        "required": [
          "reason_codes",
          "enable_low_hit",
          "enable_token_content"
        ],
        "title": "SelectionV2",
        "type": "object"
      },
      "SourceSelection": {
        "additionalProperties": false,
        "properties": {
          "source_kind": {
            "enum": [
              "base",
              "user_v2"
            ],
            "title": "Source Kind",
            "type": "string"
          },
          "base_run_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Base Run Id"
          },
          "user_run_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "User Run Id"
          },
          "appid": {
            "minLength": 1,
            "title": "Appid",
            "type": "string"
          },
          "window": {
            "anyOf": [
              {
                "$ref": "#/$defs/TimeWindow"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "expected_index_revision": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Index Revision"
          }
        },
        "required": [
          "source_kind",
          "appid"
        ],
        "title": "SourceSelection",
        "type": "object"
      },
      "TimeWindow": {
        "additionalProperties": false,
        "properties": {
          "start_ns": {
            "title": "Start Ns",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$"
          },
          "end_ns": {
            "title": "End Ns",
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]*)$"
          }
        },
        "required": [
          "start_ns",
          "end_ns"
        ],
        "title": "TimeWindow",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": "diagnostics-execution-2",
        "default": "diagnostics-execution-2",
        "title": "Version",
        "type": "string"
      },
      "request": {
        "$ref": "#/$defs/RequestV2"
      },
      "options": {
        "$ref": "#/$defs/RuntimeV2"
      }
    },
    "required": [
      "request",
      "options"
    ],
    "title": "SubmissionV2",
    "type": "object"
  },
  "catalog": {
    "$defs": {
