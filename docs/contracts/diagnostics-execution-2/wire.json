          "plan_refs",
          "status",
          "error_code",
          "report_published",
          "report_ref",
          "report_digest",
          "scope_id",
          "binding",
          "binding_id",
          "directions",
          "sequence",
          "terminal_at",
          "published_at",
          "analysis_completed_at",
          "legacy",
          "default_eligible",
          "scope"
