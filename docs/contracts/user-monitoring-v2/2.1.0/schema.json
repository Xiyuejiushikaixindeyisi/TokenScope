        "service_instance_id",
        "request",
        "source",
        "defaults",
        "chunk_tokens_origin",
        "evaluation"
      ],
      "title": "AutoEvaluation",
      "type": "object"
    },
    "AutoEvaluationRequest": {
      "additionalProperties": false,
      "properties": {
        "submission_key": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Submission Key",
          "type": "string"
        },
        "user_run_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "User Run Id",
          "type": "string"
        },
        "appid": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Appid",
          "type": "string"
        },
        "index_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Index Revision",
          "type": "string"
        },
        "target_seconds": {
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Target Seconds",
          "type": "string"
        },
        "waiting_seconds": {
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Waiting Seconds",
          "type": "string"
        },
        "comparator": {
          "default": "le",
          "enum": [
            "le",
            "lt"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "chunk_tokens": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Tokens"
        },
        "default_revision": {
          "anyOf": [
            {
              "maxLength": 18,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Revision"
        }
      },
      "required": [
        "submission_key",
        "user_run_id",
        "appid",
        "index_revision",
        "target_seconds",
        "waiting_seconds"
      ],
      "title": "AutoEvaluationRequest",
      "type": "object"
    },
