    "/monitoring/user-v2/runs/{user_run_id}/rankings": {
      "get": {
        "operationId": "get_runs_user_run_id_rankings",
        "x-runtime-implemented": false,
        "parameters": [
          {
            "name": "user_run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "X-TokenScope-Instance-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "appid_contains",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bin_width",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                1000,
                2000,
                5000
              ],
              "default": 5000
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "request_count",
                "ideal_hit_rate",
                "total_ideal_compute_tokens",
                "typical_ideal_compute_tokens"
              ],
              "default": "request_count"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          },
          {
            "name": "request_count_min",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 128
            }
          },
          {
            "name": "request_count_max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 128
            }
          },
          {
            "name": "ideal_hit_rate_min",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 128
            }
          },
          {
            "name": "ideal_hit_rate_max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 128
            }
          },
          {
            "name": "total_ideal_compute_tokens_min",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 128
            }
          },
          {
            "name": "total_ideal_compute_tokens_max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 128
            }
          },
          {
            "name": "typical_ideal_compute_tokens_min",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 128
            }
          },
          {
            "name": "typical_ideal_compute_tokens_max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "maxLength": 128
            }
          },
          {
            "name": "index_revision",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "default": "0"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ranking"
                }
              }
            }
          },
