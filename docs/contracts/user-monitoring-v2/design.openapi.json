      },
      "Evaluation": {
        "additionalProperties": false,
        "properties": {
          "evaluation_id": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Evaluation Id",
            "type": "string"
          },
          "service_instance_id": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Service Instance Id",
            "type": "string"
          },
          "request": {
            "$ref": "#/components/schemas/EvaluationRequest"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          },
          "status": {
            "enum": [
              "reference",
              "reference_with_limit",
              "no_budget",
              "out_of_scope",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "request_count": {
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)$",
            "title": "Request Count",
            "type": "string"
          },
          "prompt_p90": {
            "anyOf": [
              {
                "maxLength": 128,
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string"
              },
              {
                "type": "null"
