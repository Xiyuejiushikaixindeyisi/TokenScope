  "components": {
    "schemas": {
      "Capability": {
        "properties": {
          "executable": {
            "type": "boolean",
            "title": "Executable"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "disabled",
              "not_supported"
            ],
            "title": "Status"
          },
          "strategy": {
            "type": "string",
            "title": "Strategy"
          },
          "simulation_semantics": {
            "type": "string",
            "enum": [
              "full_block_rule",
              "chained_approximation"
            ],
            "title": "Simulation Semantics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "executable",
          "status",
          "strategy",
          "simulation_semantics"
        ],
        "title": "Capability"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelSettings": {
        "properties": {
          "model_id": {
            "type": "string",
            "enum": [
              "GLM-5.2",
              "Qwen3.6-27B",
              "DeepSeek-V4-Flash-0731"
            ],
            "title": "Model Id"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Revision",
            "default": 1
          },
          "block_size": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Block Size"
          },
          "block_size_unit": {
            "type": "string",
            "const": "simulation_input_tokens",
            "title": "Block Size Unit",
            "default": "simulation_input_tokens"
          },
          "cp_world_size": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Cp World Size",
            "default": 1
          },
          "mtp": {
            "type": "boolean",
            "title": "Mtp",
            "default": true
          },
          "prefix_cache_enabled": {
            "type": "boolean",
            "title": "Prefix Cache Enabled",
            "default": true
          },
          "hybrid_enabled": {
            "type": "boolean",
            "title": "Hybrid Enabled",
            "default": false
          },
          "cache_mode": {
            "type": "string",
            "enum": [
              "full_block",
              "full_block_approximation",
              "qwen_hybrid",
              "deepseek_hybrid"
            ],
            "title": "Cache Mode"
          },
          "model_aliases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Model Aliases",
            "default": []
          },
          "encoding_profile": {
            "type": "string",
            "title": "Encoding Profile",
            "default": "default"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_id",
          "block_size",
          "cache_mode"
        ],
        "title": "ModelSettings"
      },
      "ModelView": {
        "properties": {
          "settings": {
            "$ref": "#/components/schemas/ModelSettings"
          },
          "capability": {
            "$ref": "#/components/schemas/Capability"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "settings",
          "capability"
        ],
        "title": "ModelView"
      },
      "RuleUpdate": {
        "properties": {
          "appid": {
            "type": "string",
            "minLength": 1,
            "title": "Appid"
          },
          "model_id": {
            "type": "string",
            "enum": [
              "GLM-5.2",
              "Qwen3.6-27B",
              "DeepSeek-V4-Flash-0731"
            ],
            "title": "Model Id"
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "title": "Rule Id"
          },
          "expected_revision": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "comparator": {
            "type": "string",
            "enum": [
              "lt",
              "le",
              "gt",
              "ge"
            ],
            "title": "Comparator"
          },
          "threshold": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "title": "Threshold"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "route": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "prefix_analysis",
                  "length_analysis",
                  "signal_only"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          },
          "measurement_signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Measurement Signature"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "appid",
          "model_id",
          "rule_id",
          "expected_revision",
          "metric",
          "comparator",
          "threshold",
          "measurement_signature"
        ],
        "title": "RuleUpdate"
      },
      "RunState": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "file_ref": {
            "type": "string",
            "title": "File Ref"
          },
          "model_id": {
            "type": "string",
            "enum": [
              "GLM-5.2",
              "Qwen3.6-27B",
              "DeepSeek-V4-Flash-0731"
            ],
            "title": "Model Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "no_valid_rows",
              "failed",
              "interrupted"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "settings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelSettings"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "snapshot": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "file_ref",
          "model_id",
          "status",
          "created_at"
        ],
        "title": "RunState"
      },
