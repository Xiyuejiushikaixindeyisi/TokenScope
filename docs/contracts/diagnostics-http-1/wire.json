{
  "analysis_contract": "analysis-common-1.0",
  "models": {
    "Authorization": {
      "additionalProperties": false,
      "properties": {
        "business_basis_ref": {
          "minLength": 1,
          "title": "Business Basis Ref",
          "type": "string"
        },
        "fragment_id": {
          "minLength": 1,
          "title": "Fragment Id",
          "type": "string"
        },
        "handler_id": {
          "enum": [
            "replace_payload_with_reference",
            "remove_authorized_duplicate_message"
          ],
          "title": "Handler Id",
          "type": "string"
        },
        "handler_version": {
          "minLength": 1,
          "title": "Handler Version",
          "type": "string"
        },
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "parameters_json": {
          "title": "Parameters Json",
          "type": "string"
        },
        "selected_unit_id": {
          "minLength": 1,
          "title": "Selected Unit Id",
          "type": "string"
        },
        "submission_key": {
          "minLength": 1,
          "title": "Submission Key",
          "type": "string"
        }
      },
      "required": [
        "fragment_id",
        "observation_id",
        "selected_unit_id",
        "handler_id",
        "handler_version",
        "parameters_json",
        "business_basis_ref",
        "submission_key"
      ],
      "title": "Authorization",
      "type": "object"
    },
    "Combination": {
      "$defs": {
        "PlanReference": {
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "minLength": 1,
              "title": "Plan Id",
              "type": "string"
            },
            "task_id": {
              "minLength": 1,
              "title": "Task Id",
              "type": "string"
            }
          },
          "required": [
            "task_id",
            "plan_id"
          ],
          "title": "PlanReference",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "plan_refs": {
          "items": {
            "$ref": "#/$defs/PlanReference"
          },
          "title": "Plan Refs",
          "type": "array"
        },
        "submission_key": {
          "minLength": 1,
          "title": "Submission Key",
          "type": "string"
        }
      },
      "required": [
        "plan_refs",
        "submission_key"
      ],
      "title": "Combination",
      "type": "object"
    },
    "LowHitEvaluation": {
      "additionalProperties": false,
      "properties": {
        "finding_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "submission_key": {
          "minLength": 1,
          "title": "Submission Key",
          "type": "string"
        }
      },
      "required": [
        "finding_ids",
        "submission_key"
      ],
      "title": "LowHitEvaluation",
      "type": "object"
    },
    "Retry": {
      "additionalProperties": false,
      "properties": {
        "submission_key": {
          "minLength": 1,
          "title": "Submission Key",
          "type": "string"
        }
      },
      "required": [
        "submission_key"
      ],
      "title": "Retry",
      "type": "object"
    },
    "Submission": {
      "$defs": {
        "BudgetSpec": {
          "additionalProperties": false,
          "properties": {
            "max_candidates": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Candidates",
              "type": "string",
              "x-integer-exclusiveMinimum": "0"
            },
            "max_comparison_bytes": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Comparison Bytes",
              "type": "string",
              "x-integer-exclusiveMinimum": "0"
            },
            "max_depth": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Depth",
              "type": "string",
              "x-integer-exclusiveMinimum": "0"
            },
            "max_encoding_calls": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Encoding Calls",
              "type": "string",
              "x-integer-exclusiveMinimum": "0"
            },
            "max_request_bytes": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Request Bytes",
              "type": "string",
              "x-integer-exclusiveMinimum": "0"
            },
            "max_units": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Units",
              "type": "string",
              "x-integer-exclusiveMinimum": "0"
            }
          },
          "required": [
            "max_request_bytes",
            "max_units",
            "max_comparison_bytes",
            "max_depth",
            "max_candidates",
            "max_encoding_calls"
          ],
          "title": "BudgetSpec",
          "type": "object"
        },
        "DiagnosticRequest": {
          "additionalProperties": false,
          "properties": {
            "reason_note": {
              "default": "",
              "title": "Reason Note",
              "type": "string"
            },
            "selection": {
              "$ref": "#/$defs/DiagnosticSelection"
            },
            "source": {
              "$ref": "#/$defs/SourceSelection"
            },
            "submission_key": {
              "minLength": 1,
              "title": "Submission Key",
              "type": "string"
            }
          },
          "required": [
            "source",
            "selection",
            "submission_key"
          ],
          "title": "DiagnosticRequest",
          "type": "object"
        },
        "DiagnosticSelection": {
          "additionalProperties": false,
          "properties": {
            "enable_low_hit": {
              "title": "Enable Low Hit",
              "type": "boolean"
            },
            "enable_token_content": {
              "title": "Enable Token Content",
              "type": "boolean"
            },
            "reason_codes": {
              "items": {
                "enum": [
                  "low_hit",
                  "request_length",
                  "qps"
                ],
                "type": "string"
              },
              "title": "Reason Codes",
              "type": "array"
            }
          },
          "required": [
            "reason_codes",
            "enable_low_hit",
            "enable_token_content"
          ],
          "title": "DiagnosticSelection",
          "type": "object"
        },
        "PluginSelection": {
          "additionalProperties": false,
          "properties": {
            "budget": {
              "$ref": "#/$defs/BudgetSpec"
            },
            "policies_json": {
              "default": "[]",
              "title": "Policies Json",
              "type": "string"
            },
            "rule_ids": {
              "items": {
                "type": "string"
              },
              "title": "Rule Ids",
              "type": "array"
            }
          },
          "required": [
            "rule_ids",
            "budget"
          ],
          "title": "PluginSelection",
          "type": "object"
        },
        "RuntimeOptions": {
          "additionalProperties": false,
          "properties": {
            "candidate_limit": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Candidate Limit",
              "type": "string",
              "x-integer-maximum": "128",
              "x-integer-minimum": "1"
            },
            "max_combinations": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Combinations",
              "type": "string",
              "x-integer-minimum": "0"
            },
            "max_encoding_calls": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Encoding Calls",
              "type": "string",
              "x-integer-minimum": "1"
            },
            "max_experiments": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Experiments",
              "type": "string",
              "x-integer-minimum": "1"
            },
            "max_findings": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Findings",
              "type": "string",
              "x-integer-minimum": "1"
            },
            "max_plan_bytes": {
              "default": "16777216",
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Plan Bytes",
              "type": "string",
              "x-integer-minimum": "1"
            },
            "max_source_bytes": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Source Bytes",
              "type": "string",
              "x-integer-minimum": "1"
            },
            "max_source_requests": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Max Source Requests",
              "type": "string",
              "x-integer-minimum": "1"
            },
            "pilot_limit": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Pilot Limit",
              "type": "string",
              "x-integer-minimum": "2"
            },
            "token_selection": {
              "$ref": "#/$defs/PluginSelection"
            },
            "version": {
              "default": "diagnostics-runtime-1",
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "token_selection",
            "candidate_limit",
            "pilot_limit",
            "max_source_requests",
            "max_source_bytes",
            "max_findings",
            "max_experiments",
            "max_combinations",
            "max_encoding_calls"
          ],
          "title": "RuntimeOptions",
          "type": "object"
        },
        "SourceSelection": {
          "additionalProperties": false,
          "properties": {
            "appid": {
              "minLength": 1,
              "title": "Appid",
              "type": "string"
            },
            "base_run_id": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Base Run Id"
            },
            "expected_index_revision": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expected Index Revision"
            },
            "source_kind": {
              "enum": [
                "base",
                "user_v2"
              ],
              "title": "Source Kind",
              "type": "string"
            },
            "user_run_id": {
              "anyOf": [
                {
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "User Run Id"
            },
            "window": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TimeWindow"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "source_kind",
            "appid"
          ],
          "title": "SourceSelection",
          "type": "object"
        },
        "TimeWindow": {
          "additionalProperties": false,
          "properties": {
            "end_ns": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "End Ns",
              "type": "string"
            },
            "start_ns": {
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "title": "Start Ns",
              "type": "string"
            }
          },
          "required": [
            "start_ns",
            "end_ns"
          ],
          "title": "TimeWindow",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "options": {
          "$ref": "#/$defs/RuntimeOptions"
        },
        "request": {
          "$ref": "#/$defs/DiagnosticRequest"
        }
      },
      "required": [
        "request",
        "options"
      ],
      "title": "Submission",
      "type": "object"
    },
    "TokenEvaluation": {
      "additionalProperties": false,
      "properties": {
        "business_basis_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Basis Ref"
        },
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "fragment_id": {
          "minLength": 1,
          "title": "Fragment Id",
          "type": "string"
        },
        "parameters_json": {
          "title": "Parameters Json",
          "type": "string"
        },
        "submission_key": {
          "minLength": 1,
          "title": "Submission Key",
          "type": "string"
        }
      },
      "required": [
        "fragment_id",
        "candidate_id",
        "parameters_json",
        "submission_key"
      ],
      "title": "TokenEvaluation",
      "type": "object"
    }
  },
  "version": "diagnostics-http-1"
}
