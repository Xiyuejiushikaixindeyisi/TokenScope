{
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "available",
            "partial",
            "unavailable",
            "empty"
          ],
          "title": "State",
          "type": "string"
        },
        "sample_count": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Sample Count",
          "type": "string"
        },
        "population_count": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Population Count",
          "type": "string"
        },
        "numerator": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Numerator"
        },
        "denominator": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator"
        },
        "denominator_unit": {
          "enum": [
            "input_tokens",
            "seconds",
            "none"
          ],
          "title": "Denominator Unit",
          "type": "string"
        },
        "reasons": {
          "items": {
            "enum": [
              "empty_now",
              "empty_bin",
              "no_valid_prompt",
              "source_cached_missing",
              "invalid_cached",
              "invalid_prompt",
              "no_real_samples",
              "no_paired_samples",
              "no_ideal_samples",
              "warmup_order_conflict",
              "no_valid_prewarm",
              "zero_input_denominator",
              "partial_sample_coverage"
            ],
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "state",
        "sample_count",
        "population_count",
        "numerator",
        "denominator",
        "denominator_unit",
        "reasons"
      ],
      "title": "Availability",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "assigned": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Assigned",
          "type": "string"
        },
        "production_input": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Production Input",
          "type": "string"
        },
        "real": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Real",
          "type": "string"
        },
        "encoded": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Encoded",
          "type": "string"
        },
        "paired": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Paired",
          "type": "string"
        }
      },
      "required": [
        "assigned",
        "production_input",
        "real",
        "encoded",
        "paired"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "FieldIssue": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "code": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "count": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Count",
          "type": "string"
        }
      },
      "required": [
        "field",
        "code",
        "count"
      ],
      "title": "FieldIssue",
      "type": "object"
    },
    "InstanceAvailability": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "instance_uuid": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Instance Uuid",
          "type": "string"
        },
        "model_standard_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Model Standard Name",
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "bins": {
          "items": {
            "$ref": "#/$defs/Availability"
          },
          "maxItems": 12,
          "minItems": 12,
          "title": "Bins",
          "type": "array"
        },
        "now_field_issues": {
          "items": {
            "$ref": "#/$defs/FieldIssue"
          },
          "title": "Now Field Issues",
          "type": "array"
        },
        "warmup": {
          "$ref": "#/$defs/WarmupEvidence"
        }
      },
      "required": [
        "instance_uuid",
        "model_standard_name",
        "coverage",
        "metrics",
        "bins",
        "now_field_issues",
        "warmup"
      ],
      "title": "InstanceAvailability",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "paired_ideal_hit_rate": {
          "$ref": "#/$defs/Availability"
        },
        "paired_real_hit_rate": {
          "$ref": "#/$defs/Availability"
        },
        "independent_ideal_hit_rate": {
          "$ref": "#/$defs/Availability"
        },
        "independent_real_hit_rate": {
          "$ref": "#/$defs/Availability"
        },
        "actual_uncached_tokens": {
          "$ref": "#/$defs/Availability"
        },
        "hour_uncached_tokens_per_second": {
          "$ref": "#/$defs/Availability"
        }
      },
      "required": [
        "paired_ideal_hit_rate",
        "paired_real_hit_rate",
        "independent_ideal_hit_rate",
        "independent_real_hit_rate",
        "actual_uncached_tokens",
        "hour_uncached_tokens_per_second"
      ],
      "title": "Metrics",
      "type": "object"
    },
    "Submit": {
      "additionalProperties": false,
      "properties": {
        "submission_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Submission Key",
          "type": "string"
        },
        "pre_file_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Pre File Ref",
          "type": "string"
        },
        "now_file_ref": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Now File Ref",
          "type": "string"
        },
        "model_standard_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Model Standard Name",
          "type": "string"
        },
        "model_id": {
          "enum": [
            "GLM-5.2",
            "Qwen3.6-27B",
            "DeepSeek-V4-Flash-0731"
          ],
          "title": "Model Id",
          "type": "string"
        },
        "pre_start": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Pre Start",
          "type": "string"
        },
        "now_start": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Now Start",
          "type": "string"
        },
        "now_end": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Now End",
          "type": "string"
        },
        "source_timezone": {
          "const": "UTC",
          "default": "UTC",
          "title": "Source Timezone",
          "type": "string"
        }
      },
      "required": [
        "submission_key",
        "pre_file_ref",
        "now_file_ref",
        "model_standard_name",
        "model_id",
        "pre_start",
        "now_start",
        "now_end"
      ],
      "title": "Submit",
      "type": "object"
    },
    "WarmupEvidence": {
      "additionalProperties": false,
      "properties": {
        "encoded_pre_count": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Encoded Pre Count",
          "type": "string"
        },
        "encoded_now_count": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Encoded Now Count",
          "type": "string"
        },
        "pre_max_handle_time": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pre Max Handle Time"
        },
        "now_min_handle_time": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Now Min Handle Time"
        },
        "comparison": {
          "const": "pre_max_gt_now_min",
          "default": "pre_max_gt_now_min",
          "title": "Comparison",
          "type": "string"
        },
        "equal_time_order": {
          "const": "pre_first_then_source_record_index",
          "default": "pre_first_then_source_record_index",
          "title": "Equal Time Order",
          "type": "string"
        }
      },
      "required": [
        "encoded_pre_count",
        "encoded_now_count",
        "pre_max_handle_time",
        "now_min_handle_time"
      ],
      "title": "WarmupEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "service_instance_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Service Instance Id",
      "type": "string"
    },
    "ma_run_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Ma Run Id",
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/Submit"
    },
    "availability": {
      "$ref": "#/$defs/InstanceAvailability"
    }
  },
  "required": [
    "service_instance_id",
    "ma_run_id",
    "binding",
    "availability"
  ],
  "title": "AvailabilityResponse",
  "type": "object"
}
